<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 (API 31) and newer.
   Android 11 and older use backup_rules.xml instead; keep the two in step.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Only exclusions are listed, so everything else is still backed up and
   transferred as before.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The demo profile is "stored only on this phone", so it is never backed up. -->
        <exclude domain="file" path="datastore/demo_profile.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Nor is it copied to a new phone. -->
        <exclude domain="file" path="datastore/demo_profile.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
