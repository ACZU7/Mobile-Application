<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 (API 30) and older.
   Android 12 and newer use data_extraction_rules.xml instead; keep the two in step.
   See https://developer.android.com/guide/topics/data/autobackup

   Only exclusions are listed, so everything else is still backed up as before.
-->
<full-backup-content>
    <!-- The demo profile is "stored only on this phone", so it is never backed up. -->
    <exclude domain="file" path="datastore/demo_profile.preferences_pb" />
</full-backup-content>
